function RestrictSpecialCharacter(e) {
    var theEvent = e || window.event;
    var key = theEvent.keyCode || theEvent.which;
    key = String.fromCharCode(key);
    var regex = /[A-Za-z\s]$/
    if (! regex.test(key)) {
        theEvent.returnValue = false;
        if (theEvent.preventDefault) {
            theEvent.preventDefault();
        }
    }
}

	function openPopUp(ele){

		var parent = ele.parentElement;
		var img_name = parent.getElementsByClassName("custom-file-input")[0].name;
		var signed_url = $("#"+img_name).attr("signed-url");
		img_name += "_hidden";

		var src = $("#"+img_name).val().trim();

		if(src.startsWith("https://storage.cloud.google.com")){
		    extension = src.split('.').pop();
		    if(extension == "jpg" || extension == "jpeg"){
			    $(".image-popup-link").attr("href",signed_url);
			    $(".image-popup-link").click();
		    }else{
			    $(".pdf-popup-link").attr("href",signed_url);
//			    $(".pdf-popup-link").trigger("click");
                parent.getElementsByClassName("pdf-popup-link")[0].click();
		    }
		}else{
			extension = src.match(/[^:/]\w+(?=;|,)/)[0];
	        if(extension == "jpg" || extension == "jpeg"){
			    $(".image-popup-link").attr("href",$("#"+img_name).val());
			    $(".image-popup-link").click();
		    }else{
			    $(".pdf-popup-link").attr("href",$("#"+img_name).val());
//			    $(".pdf-popup-link").trigger("click");
                parent.getElementsByClassName("pdf-popup-link")[0].click();
		    }
		}



	}
function get_exam_taker_role(){
    let exam_taker_role_choices = document.getElementsByName("exam_taker_role");
    let exam_taker_role = "";
    for(let i = 0; i < exam_taker_role_choices.length; i++){
        if(exam_taker_role_choices[i].checked){
            exam_taker_role = exam_taker_role_choices[i].value;
        }
    }
    return exam_taker_role
}
function validateExamForm(){
    $('#name').removeAttr('disabled');
    $('#date_of_birth').removeAttr('disabled');
    $('input[name="gender"]').removeAttr('disabled');

    if (!document.getElementById('address_consent').checked) {
    document.getElementById("address_consent").focus();
    alert("Please confirm that you do not have any issues sharing your address");
    return false;
    }

    var userNameField = document.getElementById("name");
    if(userNameField.value == "" || ! userNameField.value ){
        userNameField.focus();
        alert("Please enter name");
        return false;
    }else{
        input_name_value = userNameField.value;
        userNameField.value = input_name_value.trim();
        var regex = /^([A-Za-z]+ )+[A-Za-z]+$|^[A-Za-z]+$/
        if(!regex.test(userNameField.value)){
            alert("Name should not have any special characters, numbers, more than one spaces in name");
            return false;
        }

    }

    var dateOfBirthField = document.getElementById("date_of_birth");
    if(! dateOfBirthField.value){
        dateOfBirthField.focus();
        alert("Please enter date of birth");
        return false;
    }

     var dob_field = document.getElementById("date_of_birth");
     var date_of_birth = dob_field.value;
     var current_year_field = document.getElementById("current_year")
     if (current_year_field != null || typeof(current_year_field) != 'undefined') {
        var current_year = parseInt(current_year_field.value);
        var formatted_date_of_birth = new Date(date_of_birth.replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"));
        // Validate if the Date of Birth is within the acceptable range
        // i.e dob_year > {current year - 110} and dob_year < {current year - 5} (the range is based on date-picker rendering)
        var threshold_year = current_year - 5
        if (formatted_date_of_birth.getFullYear() > threshold_year) {
            dob_field.focus();
            alert('Birth year cannot be greater than ' + threshold_year + ', Please add appropriate birth year.');
            return false;
        }
        var threshold_year_min = current_year - 110
        if (formatted_date_of_birth.getFullYear() < threshold_year_min){
            dob_field.focus();
            alert('Birth year cannot be lesser than ' + threshold_year_min + ', Please add appropriate birth year.');
            return false;
        }
     }

    var address_countryField = document.getElementById("address_country");
    var address_countryFieldValue = address_countryField.value
    if(!address_countryFieldValue || address_countryFieldValue == "" || address_countryFieldValue == "Select" || address_countryFieldValue == "Select a value"){
        address_countryField.focus();
        alert("Please check Country field");
        return false;
    }
    if(address_countryFieldValue == 'other'){
        var other_address_countryField = document.getElementById("other_address_country");
        if(other_address_countryField.value == "" || other_address_countryField.value.length > 40){
            other_address_countryField.focus();
            alert("Please enter a valid Country Name. It should not be empty and should not exceed 40 characters.");
            return false;
        }
    }

    var address_stateField = document.getElementById("address_state");
    var address_stateFieldValue = address_stateField.value
    if(!address_stateFieldValue || address_stateFieldValue == "" || address_stateFieldValue == "Select" || address_stateFieldValue == "Select a value"){
        address_stateField.focus();
        alert("Please check State field");
        return false;
    }
    if(address_stateFieldValue == 'other'){
        var other_address_stateField = document.getElementById("other_address_state");
        if(other_address_stateField.value == "" || other_address_stateField.value.length > 40){
            other_address_stateField.focus();
            alert("Please enter a valid State Name. It should not be empty and should not exceed 40 characters.");
            return false;
        }
    }

    var address_cityField = document.getElementById("address_city");
