}
function validateFileSizeAndExtension(id, name) {
    let element = document.getElementById(id);
    let hidden_element = document.getElementById(`${id}_hidden`);
    //file size validation
    let proof_validation = validateFileSize(element, hidden_element, 50, 2000);
    if(! proof_validation){
        element.focus();
        alert(`Please upload JPEG/JPG/PDF file in range of 50KB to 2MB for ${name}`);
        return false;
    }
    //check file extension
    let file_type_validation = validateFileExtension(element, hidden_element,["jpg", "jpeg", "JPG", "JPEG", "pdf", "PDF"]);
    if(! file_type_validation){
        element.focus();
        alert(`Only PDF, JPEG file is allowed for uploading ${name}`);
        return false;
    }
    return true;
}

function validateFileExtension(component, hidden_component, extns)
{
    let filename = component.nextElementSibling.innerText;
    var file_url = component.getAttribute('value').trim();
    var hidden_file_value = hidden_component.value;
    var is_url = file_url.startsWith("https://storage.cloud.google.com")
    var ext = ""
    if(is_url && filename == "File Uploaded"){
        // Commented the below line as we do no want to re-verify the already uploaded document
        //ext = file_url.substring(file_url.lastIndexOf(".")+1)
        return true;
    }else{
        if(! hidden_file_value || hidden_file_value == ""){
            return false;
        }
        // This extracts the extension from the file name
        filenameExtension = filename.substring(filename.lastIndexOf(".")+1);
        // This extracts the the extension from the base64 converted value
        ext = hidden_file_value.match(/[^:/]\w+(?=;|,)/)[0];
    }

    // Checking if the base64 matches or not
    if(ext!= "" && extns.includes(ext)){
        // Checking if the filename extension matches or not
        if(filename != "File Uploaded"){
            if(filenameExtension != "" && extns.includes(filenameExtension)){
                return true;
            }else{
                component.focus();
                return false;
            }
        }
    }else{
            component.focus();
            return false;
    }

}

function validateFileUploaded(hidden_component){
    return (hidden_component.value.startsWith(' https://storage.cloud.google.com') || hidden_component.value.startsWith('data:'));
}

function validateFileSize(component, hidden_component,minSize, maxSize)
{
   var size =0;
   if(navigator.appName=="Microsoft Internet Explorer")
   {
      if(component.value)
      {
         var oas=new ActiveXObject("Scripting.FileSystemObject");
         var e=oas.getFile(component.value);
         size = (e.size / 1024 ).toFixed(2);
      }
   }
   else
   {
      if(component.files && component.files[0]!=undefined)
      {

         size = (component.files[0].size/ 1024).toFixed(2);
         if(size!=undefined && minSize <size && size <maxSize){
            return true;
         }
      return false;
      }
      else{
         if(component.getAttribute('value')!= "" && hidden_component.value!= "" && component.getAttribute('value') == hidden_component.value){
            return true;
         }
         return false;
      }
   }

}


$( document ).ready(function () {
    var cityConstants = $.ajax({
  		method: 'GET',
  		url: CITY_JSON_PATH,
  		dataType: "text",
  		async: false,
	});
	const CITY_JSON = JSON.parse(cityConstants.responseText);
	var dob = $('.datepicker').val();
	$('.datepicker').datetimepicker({
        format: 'DD/MM/YYYY'
    });
	$('.datepicker').data("DateTimePicker").date(formatDate());

	function calculateAndUpdateAge(showAlert = true) {
        var dobStr = $('.datepicker').val();
        if (!dobStr) {
            document.getElementById('calculated-age').value = "—";
            return;
        }
        var dob = moment(dobStr, "DD/MM/YYYY");
        if (!dob.isValid()) {
            document.getElementById('calculated-age').value = "—";
            return;
        }
        var today = moment();
        var age = today.diff(dob, 'years');
        if (age >= 0) {
            document.getElementById('calculated-age').value = age + " years";
            if (showAlert && age < 10) {
                alert("According to the entered date of birth, the calculated age is below 10 years. Please verify that the date of birth is correct.");
            }
        } else {
            document.getElementById('calculated-age').value = "—";
        }
    }

    calculateAndUpdateAge();
    let hasNewDateBeenSelected = false;
    $(".datepicker").on("dp.change", function (e) {
        $(this).data("DateTimePicker").maxDate(moment().subtract(5, 'years'));
        $(this).data("DateTimePicker").minDate(moment().subtract(110, 'years'));
        hasNewDateBeenSelected = true;
    });

    $('.datepicker').on('dp.hide', function () {
        if (hasNewDateBeenSelected) {
            calculateAndUpdateAge(true);
            hasNewDateBeenSelected = false;
        }
    });

    $('.datepicker').on('input', function () {
        document.getElementById('calculated-age').value = "—";
        hasNewDateBeenSelected = true;
        var dob_text = $('.datepicker').val();
        var dob_val = moment(dob_text, "DD/MM/YYYY", true);
        if (dob_val.isValid()) {
            var today = moment();
            var age_val = today.diff(dob_val, 'years');
            if (age_val >= 0) {
                document.getElementById('calculated-age').value = age_val + " years";
            }
        }
        else {
           document.getElementById('calculated-age').value = "—";
        }
    });

    if(document.getElementById('pwd_category').value !== 'Select' && document.getElementById("is_physically_challenged_True").checked){
        show_dependent_field('is_physically_challenged-dependent');
    }
    prefillCountry();
    prefillState();
    prefillCity();
    $('.image-popup-link').magnificPopup({type:'image'});
    document.getElementById('is_scst_True').onclick = showField;
    document.getElementById('is_scst_False').onclick = clearField;
    document.getElementById('from_outside_india_True').onclick = showFieldOutsideIndia;
    document.getElementById('from_outside_india_False').onclick = clearFieldOutsideIndia;

    document.getElementById("is_physically_challenged_True").addEventListener('click', function (event) {
            show_dependent_field('pwd_category-dependent');
            if(document.getElementById('pwd_category').value !== 'Select'){
                show_dependent_field('is_physically_challenged-dependent');
            }
    });
    document.getElementById("is_physically_challenged_False").addEventListener('click', function (event) {
            document.getElementsByClassName('pwd_category-dependent')[1].removeAttribute("style");
            document.getElementsByClassName('pwd_category-dependent')[1].classList.add('hidden-field');
            document.getElementsByClassName('is_physically_challenged-dependent')[0].removeAttribute("style");
            document.getElementsByClassName('is_physically_challenged-dependent')[0].required = false;
            document.getElementById('pwd_category').value = 'Select'
    });
   document.getElementById('pwd_category').addEventListener("change", function() {
       if( !["No", "Select"].includes(document.getElementById('pwd_category').value))
       {
           show_dependent_field('is_physically_challenged-dependent');
       }
       else
       {
            document.getElementsByClassName('is_physically_challenged-dependent')[0].removeAttribute("style");
            document.getElementsByClassName('is_physically_challenged-dependent')[0].required = false;
       }
   });

	if($("input[name='is_scst']:checked").val() == "True"){
		show_dependent_field('is_scst-dependent');
	}
    if($("input[name='from_outside_india']:checked").val() == "True"){
		show_dependent_field('from_outside_india-dependent');
        role_based_view_outside_india();
	} else {
        hide_college_faculty_company_block();
    }

	$('.custom-file-input').change(function(event) {
		fileInputChange($(this), event);
	});

	$( "input[type=file]" ).each(function() {
		var file_value = $(this).attr('value');

		if(file_value.length > 0 && file_value!= "None"){
			var file_name = $(this).attr('name');
			file_name += "_hidden";
			$("#"+file_name).val(file_value);
			fileInputChange($(this));
		}
	});

    $('#exam_taker_role_employed').click(function (event){
        if($("input[name='from_outside_india']:checked").val() == "True"){
            hide_college_faculty_block();
        }
    });
    $('#exam_taker_role_student').click(function (event){
        if($("input[name='from_outside_india']:checked").val() == "True"){
            hide_faculty_company_block();
        }
    });
    $('#exam_taker_role_faculty').click(function (event){
        if($("input[name='from_outside_india']:checked").val() == "True"){
            hide_college_company_block();
        }
    });
    $('#exam_taker_role_other').click(function (event){
        if($("input[name='from_outside_india']:checked").val() == "True"){
            hide_college_faculty_company_block();
        }
    });
   function fileInputChange(element, evt=""){
        var file_name = "File Uploaded";
        element.parent().css("background-color", "#9dbff9");
        // checking failed statuses
        if (typeof(list_of_statuses) != 'undefined' && list_of_statuses[element[0].id].includes('failed')){
            file_name = "Change Document";
            element.parent().css("background-color", "#555770");
        }
	  if(evt !== ""){
          try {
              let loader = $("#" + element[0].id + "_loader");
              if (element[0].files[0] !== undefined) {
                  file_name = element[0].files[0].name;
                  loader.addClass('loader');
                  var fReader = new FileReader();
                  fReader.readAsDataURL(element[0].files[0]);
                  fReader.onloadend = function (event) {
                      var hidden_attr = document.getElementById(element[0].name + "_hidden");
                      hidden_attr.value = event.target.result;
                      loader.removeClass('loader');
                  };
              }
          }
          catch (err) {
              $("#" + element[0].id + "_loader").removeClass('loader');
              alert("Unexpected Error occurred. Please reload the page and try again.");
          }
	  }
	  element.next('span.btnLabel').text(file_name);
	  element.parent().next('button#viewButton').show();
	}

    function showField(e) {
      var conditional_field = e.target.name + "-dependent"
      show_dependent_field(conditional_field);
    }
    function showFieldOutsideIndia(e) {
        let conditional_field = e.target.name + "-dependent"
        show_dependent_field(conditional_field)
        role_based_view_outside_india()
    }
    function clearFieldOutsideIndia(e) {
        // let conditional_field = e.target.name + "-dependent"
        clearField(e)
        $('.college-letter-button').hide();
        $('.faculty-letter-button').hide();
        $('.company-letter-button').hide();
    }
    function show_dependent_field(conditional_field){
      var fields = document.getElementsByClassName(conditional_field);
      for (var i = 0; i < fields.length; i++) {
        // display the label and input for dependent hidden fields
        fields[i].style.display = 'block';
        // turn on required for this field's input.
        fields[i].required = true;
      }
    }

    function hide_college_faculty_block() {
        $('.college-letter').hide();
        $('.college-letter-button').hide();
        $('.faculty-letter-button').hide();
        $('.company-letter').show();
        $('.company-letter-button').show();
    }
    function hide_college_company_block() {
        $('.college-letter-button').hide();
        $('.college-letter').show();
        $('.faculty-letter-button').show();
        $('.company-letter').hide();
        $('.company-letter-button').hide();
    }
    function hide_faculty_company_block() {
        $('.college-letter').show();
        $('.college-letter-button').show();
        $('.faculty-letter-button').hide();
        $('.company-letter').hide();
        $('.company-letter-button').hide();
    }
    function hide_college_faculty_company_block() {
        $('.college-letter').hide();
        $('.college-letter-button').hide();
        $('.faculty-letter-button').hide();
        $('.company-letter').hide();
        $('.company-letter-button').hide();
    }
    function role_based_view_outside_india() {
        let exam_taker_role = get_exam_taker_role();
        if(exam_taker_role == "employed"){
            hide_college_faculty_block();
        }
        if(exam_taker_role == "student"){
            hide_faculty_company_block();
        }
        if(exam_taker_role == "faculty"){
            hide_college_company_block();
        }
        if(exam_taker_role == "other"){
            hide_college_faculty_company_block();
        }
    }
    function clearField(e) {
      var conditional_field = e.target.name + "-dependent"
      var fields = document.getElementsByClassName(conditional_field);
      for (var i = 0; i < fields.length; i++) {
        // turn off required for this field's input.
        fields[i].required = false;
        // hide the label and input for dependent hidden fields
        fields[i].removeAttribute("style")

      }
    }

    $('#is_local_chapter').change(function(){
        if($(this).is(":checked")) {
            $('.input-local_chapter_college').prop('disabled', false)
        }
        else{
            $('.input-local_chapter_college').prop('disabled', true)
        }

    });

	function formatDate(){
		if(old_date_of_birth){
		    date = old_date_of_birth.replace(/ /g,"").split("-")
		    if(date.length != 3){
		        return "";
		    }
		    var yy = date[0]
		    var mm = date[1]
		    var dd = date[2]
		    return dd+"/"+mm+"/"+yy;
		}
		return "";
	}

    function element(id) {
	    return document.getElementById(id);
    }

    function showEl(el) {
        el.classList.remove('hidden-field');
        el.parentElement.classList.remove('hidden-field');
    }

    function hideEl(el) {
        el.classList.add('hidden-field');
        el.parentElement.classList.add('hidden-field');
    }

    function clearOptions(el,default_value=default_value, include_other=false){
        for(i = el.options.length; i >= 0; i--) {
            el.remove(i);
        }

        var option = document.createElement("option")
        option.text = "Select a value";
        option.value = "";
        el.appendChild(option);

        if(include_other){
            var option = document.createElement("option")
            option.text = 'Other';
            option.name = 'other';
            option.value = 'other';
            if(default_value === 'other'){
                option.selected = true;
            }
            el.appendChild(option);
        }
    }

    function prefillCountry(){
        if(old_address_country){
            if(old_address_country.toLowerCase() !== 'india'){
                other_address_country_field = element('other_address_country');
                address_country_field = element('address_country');
                address_country_field.value = 'other';
                address_country_field.selected = true;
                other_address_country_field.value = old_address_country;
                showEl(other_address_country_field);
                [
                    'address_state',
                    'address_city',
                ].forEach(function(x){
                    addressAttribute = element(x);
                    hideEl(addressAttribute);
                    clearOptions(addressAttribute,default_value='other',include_other=true);
                    other_address_field = element('other_'+x);
                    other_address_field.value = address_fields[x];
                    showEl(other_address_field);
                });
            }
            else{
                address_country_field = element('address_country');
                address_country_field.value = 'india';
                address_country_field.selected = true;
            }
        }
    }

    function prefillState() {
        if(old_address_country && old_address_state){
            if(old_address_country.toLowerCase() === 'india'){
                addressState = element('address_state')
                clearOptions(addressState,default_value='',include_other=false);
                STATE_JSON.forEach(function(v){
                    var option = document.createElement("option")
                    option.text = v.label;
                    option.name = v.name;
                    option.value = v.value;
                    if(v.value === old_address_state.toLowerCase() ){
                        option.selected = true;
                    }
                    addressState.appendChild(option);
                });
            }
        }
    }

    function prefillCity() {
        if(old_address_country && old_address_state && old_address_city){
            if (old_address_country.toLowerCase() === 'india'){
                if(!CITY_JSON[old_address_state.toLowerCase()]){
                    clearOptions(element('address_city'),default_value='other',include_other=true);
                    hideEl(element('address_city'));
                    prefill_city_field = element('other_address_city');
                    prefill_city_field.value = old_address_city;
                    showEl(prefill_city_field);
                    return;
                }
                city_select_field = element('address_city')
                clearOptions(city_select_field,default_value='',include_other=true);
                var city_available = false
                CITY_JSON[old_address_state.toLowerCase()].forEach(function(v){
                    var option = document.createElement("option")
                    option.text = v.label;
                    option.name = v.name;
                    option.value = v.value;
                    if(v.value === old_address_city.toLowerCase()){
                        option.selected = true
                        city_available = true
                    }
                    city_select_field.appendChild(option);
                });
                if(!city_available){
                    city_select_field.value = 'other';
                    city_select_field.selected = true;
                    other_address_city_field = element('other_address_city');
                    other_address_city_field.value = old_address_city;
                    showEl(other_address_city_field);
                }
            }
        }
    }

    function countryChanged() {
        countryField = element('address_country');
        if(countryField.value === 'other'){
            showEl(element('other_address_country'));
        }
        else{
            hideEl(element('other_address_country'));
            stateSelectField = element('address_state')
            clearOptions(stateSelectField,default_value='',include_other=false);
            STATE_JSON.forEach(function(v){
                var option = document.createElement("option")
                option.text = v.label;
                option.name = v.name;
                option.value = v.value;
                stateSelectField.appendChild(option);
            });
            clearOptions(element('address_city'),default_value='',include_other=false);
        }
        [
          'address_state',
          'address_city',
        ].forEach(function(x){
            if(countryField.value === 'other'){
                showEl(element('other_'+x));
                hideEl(element(x));
                clearOptions(element(x),default_value='other',include_other=true);
            }
            else{
                showEl(element(x));
                hideEl(element('other_'+x))
            }
        });
    }

    function stateChanged() {
        stateField = element('address_state');
        var selected = stateField.value;
        var select_field = document.getElementById('address_city');
        if (!selected || selected == "" || selected == "Select" || selected == "Select a value") {
            return;
        }
        if(!CITY_JSON[selected]){
            clearOptions(select_field,default_value='other',include_other=true);
            hideEl(element('address_city'));
            showEl(element('other_address_city'));
            return;
        }
        clearOptions(select_field,default_value='',include_other=true);
        CITY_JSON[selected].forEach(function(v){
            var option = document.createElement("option")
            option.text = v.label;
            option.name = v.name;
            option.value = v.value;
            select_field.appendChild(option);
        });
        showEl(element('address_city'));
        hideEl(element('other_address_city'));
    }

    function cityChanged() {
        cityField = element('address_city');
        if(cityField.value === 'other'){
            showEl(element('other_address_city'));
        }
        else{
            hideEl(element('other_address_city'));
        }
    }

    element('address_country').onchange = countryChanged;
    element('address_state').onchange = stateChanged;
    element('address_city').onchange = cityChanged;

});

